            <button class="btn sms-btn" id="sms-btn">Verify via SMS</button>
            <button class="btn email-btn" id="email-btn">Verify via Email</button>
        </div>
    </div>
    <script src="js/verificationMethodSelection.js"></script>
</body>
</html>
