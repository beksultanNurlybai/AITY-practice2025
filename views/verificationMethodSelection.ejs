<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Select Verification Method</title>
    <link rel="stylesheet" href="css/verificationMethodSelection.css">
</head>
<body>
    <div class="container">
        <div class="title">Verification</div>
        <p>To complete your registration, please select how you’d like to verify your account.</p>
